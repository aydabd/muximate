#!/bin/sh
# POSIX sh implementation of profile lifecycle and mise management.
set -eu

CONFIG_HOME=${XDG_CONFIG_HOME:-"$HOME/.config"}
ROOT=${MUXIMATE_ROOT:-"$CONFIG_HOME/muximate"}
REGISTRY="$ROOT/registry.tsv"
BASELINES="$ROOT/baselines.tsv"
MISE_ROOT="$ROOT/mise"
ACCOUNT_ROOT="$ROOT/accounts"
FRONT="$ROOT/bin/muximate"
CMUX_BIN=${CMUX_BIN:-}

die() {
  printf 'muximate: %s\n' "$*" >&2
  exit 2
}
validate_text() {
  label=$1
  value=$2
  tab=$(printf '\t')
  cr=$(printf '\r')
  nl=$(printf '\nx')
  nl=${nl%x}
  case "$value" in
    *"$tab"* | *"$cr"* | *"$nl"*) die "$label contains a forbidden control character" ;;
  esac
}
case "$ROOT" in
  /*) ;;
  *) die "configuration root must be an absolute path: $ROOT" ;;
esac
if [ -L "$ROOT" ]; then
  die "configuration root must not be a symbolic link: $ROOT"
fi
canonical() {
  target=${1:-"$PWD"}
  if [ -d "$target" ]; then
    (cd "$target" && pwd -P)
    return
  fi
  parent=$(dirname "$target")
  base=$(basename "$target")
  [ -d "$parent" ] || die "folder does not exist: $target"
  (cd "$parent" && printf '%s/%s\n' "$PWD" "$base")
}
validate_path() {
  case "$1" in /*) ;; *) die "path must be absolute: $1" ;; esac
  validate_text path "$1"
}
hash_path() {
  hash_bin=${HASH_BIN:-}
  if [ -z "$hash_bin" ]; then
    for candidate in shasum sha256sum; do
      hash_bin=$(command -v "$candidate" 2>/dev/null || true)
      [ -n "$hash_bin" ] && break
    done
  fi
  if [ -z "$hash_bin" ] && command -v openssl >/dev/null 2>&1; then hash_bin=openssl; fi
  [ -n "$hash_bin" ] || die "a SHA-256 tool is required (shasum, sha256sum, or openssl)"
  case "$hash_bin" in
    *openssl) printf '%s\n' "$1" | "$hash_bin" dgst -sha256 | awk '{print substr($NF,1,16)}' ;;
    *sha256sum*) printf '%s\n' "$1" | "$hash_bin" | awk '{print substr($1,1,16)}' ;;
    *) printf '%s\n' "$1" | "$hash_bin" -a 256 | awk '{print substr($1,1,16)}' ;;
  esac
}
secure_dirs() {
  mkdir -p "$ROOT" "$MISE_ROOT" "$ACCOUNT_ROOT"
  [ ! -L "$MISE_ROOT" ] || die "mise directory must not be a symbolic link: $MISE_ROOT"
  [ ! -L "$ACCOUNT_ROOT" ] || die "account directory must not be a symbolic link: $ACCOUNT_ROOT"
  chmod 700 "$ROOT" "$MISE_ROOT" "$ACCOUNT_ROOT"
}
provider_dirs() {
  provider_profile="$ACCOUNT_ROOT/$1"
  [ ! -L "$provider_profile" ] || die "provider profile directory must not be a symbolic link: $provider_profile"
  mkdir -p "$provider_profile"
  chmod 700 "$provider_profile"
  for provider_dir in "$provider_profile/claude" "$provider_profile/codex" "$provider_profile/copilot"; do
    [ ! -L "$provider_dir" ] || die "provider directory must not be a symbolic link: $provider_dir"
    mkdir -p "$provider_dir"
    chmod 700 "$provider_dir"
  done
  codex_config="$provider_profile/codex/config.toml"
  if [ ! -e "$codex_config" ]; then
    printf '%s\n' 'cli_auth_credentials_store = "file"' >"$codex_config"
    chmod 600 "$codex_config"
  else
    [ ! -L "$codex_config" ] || die "Codex configuration must not be a symbolic link: $codex_config"
  fi
}
lookup_file() {
  file=$1
  target=$2
  [ -r "$file" ] || return 1
  awk -F '	' -v target="$target" '
    $1 != "" && $1 !~ /^#/ &&
    (target == $1 || index(target, $1 "/") == 1) &&
    length($1) > best_len { best = $0; best_len = length($1) }
    END {
      if (best != "") { print best; exit 0 }
      exit 1
    }
  ' "$file"
}
entry_line() {
  target=$(canonical "${1:-"$PWD"}")
  line=$(lookup_file "$REGISTRY" "$target" 2>/dev/null || true)
  [ -n "$line" ] || line=$(lookup_file "$BASELINES" "$target" 2>/dev/null || true)
  [ -n "$line" ] || die "folder is not initialized or covered by a baseline: $target"
  printf '%s\n' "$line"
}
field() { printf '%s\n' "$1" | awk -F '	' -v n="$2" '{print $n}'; }
mise_bin() {
  if [ -n "${MISE_BIN:-}" ]; then
    printf '%s\n' "$MISE_BIN"
    return
  fi
  command -v mise 2>/dev/null || die "mise is not installed"
}
write_mise_file() {
  mise_file=$1
  comment=$2
  [ ! -L "$mise_file" ] || die "mise configuration must not be a symbolic link: $mise_file"
  cat >"$mise_file" <<EOF
# Machine-local mise configuration for:
# $comment
# Managed by muximate. This file is intentionally outside the repository.
[min_version]
hard = "2026.8.3"

[settings]
lockfile = true
locked = true

[tools]
EOF
  chmod 600 "$mise_file"
}
record_line() {
  table=$1
  path=$2
  profile=$3
  mise=$4
  browser=$5
  key=$6
  enabled=$7
  tmp=$(mktemp "$ROOT/profile-record.XXXXXX")
  {
    [ -r "$table" ] && awk -F '	' -v p="$path" '$1 != p {print}' "$table" || true
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$path" "$profile" "$mise" "$browser" "$key" "$enabled"
  } >"$tmp"
  mv "$tmp" "$table"
  chmod 600 "$table"
}
# The only place that creates default jars; refuses names outside the profile's own namespace.
cmux_profile() {
  jar_profile=$1
  browser=$2
  printf '%s\n' "$browser" | LC_ALL=C grep -Eq "^$jar_profile-(baseline-)?[0-9a-f]{16}\$" ||
    die "refusing to create a browser profile outside the $jar_profile namespace: $browser"
  if [ -z "$CMUX_BIN" ]; then
    case "$(uname -s 2>/dev/null || printf unknown)" in
      Darwin) CMUX_BIN=/Applications/cmux.app/Contents/Resources/bin/cmux ;;
      *) return 0 ;;
    esac
  fi
  if [ -x "$CMUX_BIN" ]; then
    if ! "$CMUX_BIN" browser profiles list 2>/dev/null | awk -v p="$browser" '$1 == p {found=1} END {exit found ? 0 : 1}'; then
      "$CMUX_BIN" browser profiles add "$browser" >/dev/null
    fi
  fi
}
cmd_init() {
  profile=${1:-}
  target=$(canonical "${2:-"$PWD"}")
  [ "$profile" = personal ] || [ "$profile" = work ] || die "profile must be personal or work"
  validate_path "$target"
  [ "$target" != / ] && [ "$target" != "$HOME" ] || die "refusing to initialize a broad folder"
  secure_dirs
  if lookup_file "$REGISTRY" "$target" >/dev/null 2>&1; then
    die "$target is already initialized"
  fi
  hash=$(hash_path "$target")
  profile_dir="$MISE_ROOT/$hash"
  [ ! -L "$profile_dir" ] || die "profile directory must not be a symbolic link: $profile_dir"
  mkdir -p "$profile_dir"
  chmod 700 "$profile_dir"
  mise="$profile_dir/mise.toml"
  browser="${profile}-${hash}"
  write_mise_file "$mise" "$target"
  provider_dirs "$profile"
  record_line "$REGISTRY" "$target" "$profile" "$mise" "$browser" "$profile" 0
  cmux_profile "$profile" "$browser"
  printf 'Initialized folder\n  path: %s\n  profile: %s\n  browser: %s\n  mise: %s\n' "$target" "$profile" "$browser" "$mise"
}
cmd_baseline() {
  profile=${1:-}
  target=$(canonical "${2:-"$PWD"}")
  validate_path "$target"
  if [ "$profile" = disable ]; then
    tmp=$(mktemp "$ROOT/baseline-disable.XXXXXX")
    awk -F '	' -v p="$target" '$1 != p {print}' "$BASELINES" >"$tmp"
    mv "$tmp" "$BASELINES"
    chmod 600 "$BASELINES"
    printf 'Baseline disabled (files retained): %s\n' "$target"
    return
  fi
  [ "$profile" = personal ] || [ "$profile" = work ] || die "baseline must be personal, work, or disable"
  [ "$target" != / ] && [ "$target" != "$HOME" ] || die "refusing to baseline a broad folder"
  secure_dirs
  hash=$(hash_path "$target")
  profile_dir="$MISE_ROOT/baseline-$hash"
  [ ! -L "$profile_dir" ] || die "baseline directory must not be a symbolic link: $profile_dir"
  mkdir -p "$profile_dir"
  chmod 700 "$profile_dir"
  mise="$profile_dir/mise.toml"
  browser="${profile}-baseline-${hash}"
  [ -r "$mise" ] || write_mise_file "$mise" "$target"
  [ -r "$BASELINES" ] || : >"$BASELINES"
  provider_dirs "$profile"
  record_line "$BASELINES" "$target" "$profile" "$mise" "$browser" "$profile" 0
  cmux_profile "$profile" "$browser"
  printf 'Baseline configured\n  path: %s\n  profile: %s\n  browser: %s\n  mise: %s\n' "$target" "$profile" "$browser" "$mise"
}
cmd_profile_configure() {
  profile=${1:-}
  gh_config=${2:-}
  ssh_key=${3:-}
  [ "$profile" = personal ] || [ "$profile" = work ] || die "profile must be personal or work"
  case "$gh_config" in /*) ;; *) die "gh config directory must be absolute" ;; esac
  validate_path "$gh_config"
  [ -d "$gh_config" ] || die "gh config directory does not exist"
  case "$ssh_key" in /*) ;; *) die "SSH key must be absolute" ;; esac
  validate_path "$ssh_key"
  [ -r "$ssh_key" ] || die "SSH key is not readable"
  secure_dirs
  tmp=$(mktemp "$ROOT/profile-config.XXXXXX")
  awk -F '	' -v p="$profile" '$1 != p {print}' "$ROOT/profiles.tsv" 2>/dev/null || true
  {
    [ -r "$ROOT/profiles.tsv" ] && awk -F '	' -v p="$profile" '$1 != p {print}' "$ROOT/profiles.tsv" || true
    printf '%s\t%s\t%s\n' "$profile" "$gh_config" "$ssh_key"
  } >"$tmp"
  mv "$tmp" "$ROOT/profiles.tsv"
  chmod 600 "$ROOT/profiles.tsv"
  printf 'Configured profile: %s\n' "$profile"
}
cmd_git_configure() {
  profile=${1:-}
  name=${2:-}
  email=${3:-}
  signing_key=${4:-}
  [ "$profile" = personal ] || [ "$profile" = work ] || die "profile must be personal or work"
  [ -n "$name" ] && [ -n "$email" ] && [ -n "$signing_key" ] || die "usage: muximate git-configure personal|work name email signing-key"
  validate_text "Git identity" "$name$email$signing_key"
  case "$signing_key" in /*) ;; *) die "signing key must be an absolute path" ;; esac
  validate_path "$signing_key"
  secure_dirs
  mkdir -p "$ROOT/git"
  chmod 700 "$ROOT/git"
  git_file="$ROOT/git/$profile.gitconfig"
  [ ! -L "$git_file" ] || die "Git identity file must not be a symbolic link: $git_file"
  {
    printf '[user]\n'
    printf '    name = %s\n' "$name"
    printf '    email = %s\n' "$email"
    printf '    signingkey = %s\n' "$signing_key"
    printf '[commit]\n    gpgsign = true\n    signoff = true\n'
  } >"$git_file"
  chmod 600 "$git_file"
  printf 'Git identity file: %s\n' "$git_file"
  printf 'Add explicitly with: git config --global includeIf.gitdir:/path/to/root/ path %s\n' "$git_file"
}
cmd_disable() {
  target=$(canonical "${1:-"$PWD"}")
  [ -r "$REGISTRY" ] || die "no registry exists"
  tmp=$(mktemp "$ROOT/profile-disable.XXXXXX")
  awk -F '	' -v p="$target" '$1 != p {print}' "$REGISTRY" >"$tmp"
  mv "$tmp" "$REGISTRY"
  chmod 600 "$REGISTRY"
  printf 'Folder profile disabled (files retained): %s\n' "$target"
}
cmd_provider_init() {
  profile=${1:-}
  [ "$profile" = personal ] || [ "$profile" = work ] || die "profile must be personal or work"
  secure_dirs
  provider_dirs "$profile"
}
create_agent_policy() {
  policy_file=$1
  provider=$2
  profile=$3
  policy_dir=$(dirname "$policy_file")
  policy_tmp=$(mktemp "$policy_dir/.agent-policy.XXXXXX")
  if ! {
    cat >"$policy_tmp" <<EOF
# Muximate $profile $provider guidance

This is user-scoped guidance for the Muximate \`$profile\` identity.

- Work only when the active Muximate profile is \`$profile\`. If unsure, run \`muximate profile\`
  from the project folder and stop if it differs.
- Never invoke \`open\`, \`/usr/bin/open\`, \`xdg-open\`, or another default-browser launcher.
- To present an HTTP or HTTPS URL, run \`muximate cmux-browser-open '<URL>'\`.
- If that command fails, print the URL and stop. Never fall back to another browser.
- Never read or use the other Muximate profile's credential or configuration directories.
- Treat these instructions as behavioral guidance, not as a security or isolation boundary.

## Browser

- The only browser commands you may run are
  \`muximate cmux-browser-open [--identity <slug>] '<URL>'\` and \`muximate browser-profiles list\`.
- Never call \`cmux\`, \`open\`, \`xdg-open\`, or any browser directly.
- Each \`--identity <slug>\` is a separate signed-in identity in this folder. Choose a slug that
  names the identity (for example \`admin\`), not the task.
- If a login page shows an already signed-in account you did not intend, stop and use a fresh
  slug instead of logging out.
- Never run \`muximate browser-profiles clear\` or \`prune\` unless the human asked.
- If a command fails, print the URL and stop.
EOF
    chmod 600 "$policy_tmp"
    ln "$policy_tmp" "$policy_file"
  }; then
    rm -f "$policy_tmp"
    die "could not create agent guidance without overwriting: $policy_file"
  fi
  rm -f "$policy_tmp"
  printf 'Created %s guidance: %s\n' "$provider" "$policy_file"
}
cmd_agent_policy_init() {
  [ "$#" -eq 1 ] || die "usage: muximate agent-policy-init personal|work"
  profile=${1:-}
  [ "$profile" = personal ] || [ "$profile" = work ] ||
    die "usage: muximate agent-policy-init personal|work"
  secure_dirs
  provider_dirs "$profile"
  claude_policy="$ACCOUNT_ROOT/$profile/claude/CLAUDE.md"
  codex_policy="$ACCOUNT_ROOT/$profile/codex/AGENTS.md"
  copilot_policy="$ACCOUNT_ROOT/$profile/copilot/copilot-instructions.md"
  for policy_file in "$claude_policy" "$codex_policy" "$copilot_policy"; do
    [ ! -L "$policy_file" ] || die "agent guidance must not be a symbolic link: $policy_file"
    if [ -e "$policy_file" ] && [ ! -f "$policy_file" ]; then
      die "agent guidance must be a regular file: $policy_file"
    fi
  done
  for policy_spec in \
    "$claude_policy|Claude" \
    "$codex_policy|Codex" \
    "$copilot_policy|Copilot"; do
    policy_file=${policy_spec%|*}
    provider=${policy_spec##*|}
    if [ -e "$policy_file" ]; then
      printf 'Kept existing %s guidance: %s\n' "$provider" "$policy_file"
      grep -q '^## Browser$' "$policy_file" ||
        printf 'Hint: %s lacks the Browser section; move it aside and re-run: muximate agent-policy-init %s\n' "$policy_file" "$profile"
    else
      create_agent_policy "$policy_file" "$provider" "$profile"
    fi
  done
}
# Shared agent layer: $ROOT/shared/AGENTS.md is the one instruction file for every agent and
# profile, and $ROOT/shared/<provider>/ holds settings. Profile files stay authoritative; the
# sync only adds what it owns and removes what it previously added. Shared files must never
# carry credentials or login configuration.
SHARED_ROOT="$ROOT/shared"
SHARED_MD_BEGIN='<!-- BEGIN muximate shared: managed by muximate agent-shared-sync; edit the shared file instead -->'
SHARED_MD_END='<!-- END muximate shared -->'
SHARED_TOML_BEGIN='# BEGIN muximate shared: managed by muximate agent-shared-sync; edit the shared file instead'
SHARED_TOML_END='# END muximate shared'
SHARED_SECRET_KEYS='token|secret|passw|api_?key|bearer|credential|auth|login|cookie|private_?key|header|orguuid|workspace_?id'
shared_source() {
  shared_file=$1
  [ ! -L "$shared_file" ] || die "shared agent file must not be a symbolic link: $shared_file"
  if [ -e "$shared_file" ] && [ ! -f "$shared_file" ]; then
    die "shared agent file must be a regular file: $shared_file"
  fi
  [ -f "$shared_file" ]
}
shared_target() {
  [ ! -L "$1" ] || die "profile agent file must not be a symbolic link: $1"
  if [ -e "$1" ] && [ ! -f "$1" ]; then die "profile agent file must be a regular file: $1"; fi
}
require_jq() {
  command -v jq >/dev/null 2>&1 || die "jq is required to sync shared JSON agent settings"
}
# Rejects JSON whose keys could configure login, credentials, or the process environment.
shared_json_guard() {
  jq -e . "$1" >/dev/null 2>&1 || die "shared agent file is not valid JSON: $1"
  bad=$(jq -r --arg re "$SHARED_SECRET_KEYS" '
    [paths | map(select(type == "string")) | .[-1]? // empty
      | select(test("(?i)(" + $re + ")") or ascii_downcase == "env")] | unique | join(", ")' "$1")
  [ -z "$bad" ] || die "shared agent file must not configure credentials, login, or env ($bad): $1"
}
# Shared Codex TOML may contain tables only, so appending it never changes the profile's
# top-level keys, and it may not name credential, login, or environment settings.
shared_toml_guard() {
  awk -v re="$SHARED_SECRET_KEYS" -v file="$1" '
    function fail(msg) { printf "muximate: %s: %s\n", msg, file > "/dev/stderr"; bad = 1; exit 2 }
    /^[[:space:]]*(#|$)/ { next }
    /^[[:space:]]*\[/ {
      seen = 1
      if (tolower($0) ~ ("(" re ")") || tolower($0) ~ /(^|[^a-z])env([^a-z]|$)/)
        fail("shared Codex table must not configure credentials, login, or env")
      next
    }
    {
      if (!seen) fail("shared Codex config may contain [tables] only, not top-level keys")
      key = $0; sub(/=.*/, "", key)
      if (tolower(key) ~ ("(" re ")") || tolower(key) ~ /(^|[^a-z])env([^a-z]|$)/)
        fail("shared Codex config must not configure credentials, login, or env")
    }
    END { exit bad ? 2 : 0 }
  ' "$1" || exit 2
}
# Prints $1 without any managed block, then appends the block built from $2 when present.
render_block() {
  block_target=$1
  block_source=$2
  block_begin=$3
  block_end=$4
  block_out=$5
  if [ -f "$block_target" ]; then
    awk -v b="$block_begin" -v e="$block_end" -v file="$block_target" '
      index($0, b) == 1 { inside = 1; next }
      inside && index($0, e) == 1 { inside = 0; next }
      inside { next }
      { lines[++n] = $0 }
      END {
        if (inside) { printf "muximate: unterminated muximate shared block: %s\n", file > "/dev/stderr"; exit 2 }
        while (n > 0 && lines[n] ~ /^[[:space:]]*$/) n--
        for (i = 1; i <= n; i++) print lines[i]
      }
    ' "$block_target" >"$block_out" || exit 2
  else
    : >"$block_out"
  fi
  if [ -n "$block_source" ]; then
    {
      [ ! -s "$block_out" ] || printf '\n'
      printf '%s\n' "$block_begin"
      cat "$block_source"
      printf '%s\n' "$block_end"
    } >>"$block_out"
  fi
}
# Fails when the shared Codex block and the profile define the same [table].
toml_table_conflicts() {
  conflicts=$(
    {
      awk '/^[[:space:]]*\[[^[]/ { gsub(/[[:space:]]/, ""); print "s\t" $0 }' "$1"
      awk -v b="$SHARED_TOML_BEGIN" -v e="$SHARED_TOML_END" '
        index($0, b) == 1 { inside = 1; next }
        inside && index($0, e) == 1 { inside = 0; next }
        !inside && /^[[:space:]]*\[[^[]/ { gsub(/[[:space:]]/, ""); print "p\t" $0 }
      ' "$2"
    } | awk -F '	' '{ seen[$2] = seen[$2] $1 } END { for (t in seen) if (seen[t] ~ /s/ && seen[t] ~ /p/) print t }'
  )
  [ -z "$conflicts" ] ||
    die "shared Codex config and profile both define $(printf '%s' "$conflicts" | tr '\n' ' ')in $2; keep each table in one place"
}
# Merges shared Claude settings into the profile. The profile wins every conflict; arrays
# are unioned; the exact contribution is recorded so a later sync can remove it again.
render_claude_settings() {
  settings=$1
  shared=$2
  owned=$3
  out=$4
  owned_out=$5
  conflicts_out=$6
  current='{}'
  [ ! -s "$settings" ] || current=$(cat "$settings")
  previous='{}'
  [ ! -s "$owned" ] || previous=$(cat "$owned")
  incoming='{}'
  [ -z "$shared" ] || incoming=$(cat "$shared")
  printf '%s' "$current" | jq -e 'type == "object"' >/dev/null 2>&1 ||
    die "profile Claude settings must be a JSON object: $settings"
  printf '%s' "$current" | jq --argjson prev "$previous" --argjson s "$incoming" '
    def strip($o):
      if ($o | type) == "object" and type == "object" then
        reduce ($o | keys_unsorted[]) as $k (.;
          if has($k) then
            if .[$k] == $o[$k] then del(.[$k])
            else .[$k] |= strip($o[$k])
              | if ((.[$k] | type) == "object" or (.[$k] | type) == "array") and (.[$k] | length) == 0
                then del(.[$k]) else . end
            end
          else . end)
      elif ($o | type) == "array" and type == "array" then
        [.[] | . as $x | select(any($o[]; . == $x) | not)]
      else . end;
    def merge($s):
      if type == "object" and ($s | type) == "object" then
        reduce ($s | keys_unsorted[]) as $k (.;
          if has($k) then .[$k] |= merge($s[$k]) else .[$k] = $s[$k] end)
      elif type == "array" and ($s | type) == "array" then
        . as $p | . + [$s[] | . as $x | select(any($p[]; . == $x) | not)]
      else . end;
    def delta($b):
      if type == "object" and ($b | type) == "object" then
        . as $m
        | reduce keys_unsorted[] as $k ({};
            if ($b | has($k)) | not then .[$k] = $m[$k]
            else ($m[$k] | delta($b[$k])) as $d | if $d == null then . else .[$k] = $d end
            end)
        | if length == 0 then null else . end
      elif type == "array" and ($b | type) == "array" then
        [.[] | . as $x | select(any($b[]; . == $x) | not)] | if length == 0 then null else . end
      elif . == $b then null
      else . end;
    def conflicts($s; $path):
      if type == "object" and ($s | type) == "object" then
        [$s | keys_unsorted[] as $k | $k] as $ks
        | . as $p | [$ks[] as $k | select($p | has($k)) | ($p[$k] | conflicts($s[$k]; $path + [$k]))[]]
      elif type == "array" and ($s | type) == "array" then []
      elif . == $s then []
      else [$path | join(".")] end;
    strip($prev) as $base
    | ($base | merge($s)) as $merged
    | {settings: $merged, owned: (($merged | delta($base)) // {}), conflicts: ($base | conflicts($s; []))}
  ' >"$out.all" || die "could not merge shared Claude settings into: $settings"
  jq '.settings' "$out.all" >"$out"
  jq '.owned' "$out.all" >"$owned_out"
  jq -r '.conflicts[]' "$out.all" >"$conflicts_out"
  rm -f "$out.all"
}
# Installs a rendered file only when it differs; keeps one backup of the replaced file.
install_rendered() {
  rendered=$1
  dest=$2
  if [ -f "$dest" ] && cmp -s "$rendered" "$dest"; then
    rm -f "$rendered"
    return
  fi
  if [ ! -s "$rendered" ] && [ ! -e "$dest" ]; then
    rm -f "$rendered"
    return
  fi
  [ ! -f "$dest" ] || cp -p "$dest" "$dest.muximate-backup"
  chmod 600 "$rendered"
  mv "$rendered" "$dest"
  printf 'updated: %s\n' "$dest"
}
cmd_agent_shared_sync() {
  check=0
  if [ "${1:-}" = --check ]; then
    check=1
    shift
  fi
  [ "$#" -eq 1 ] || die "usage: muximate agent-shared-sync [--check] personal|work|all"
  case "$1" in
    personal | work) profiles=$1 ;;
    all) profiles='personal work' ;;
    *) die "usage: muximate agent-shared-sync [--check] personal|work|all" ;;
  esac
  [ ! -L "$SHARED_ROOT" ] || die "shared agent directory must not be a symbolic link: $SHARED_ROOT"
  for shared_dir in "$SHARED_ROOT/claude" "$SHARED_ROOT/codex" "$SHARED_ROOT/copilot" "$SHARED_ROOT/copilot/hooks"; do
    [ ! -L "$shared_dir" ] || die "shared agent directory must not be a symbolic link: $shared_dir"
  done

  # Validate every shared source before any profile file is touched.
  claude_settings_src=
  agents_md_src=
  codex_toml_src=
  copilot_hooks=
  if shared_source "$SHARED_ROOT/claude/settings.json"; then
    require_jq
    claude_settings_src="$SHARED_ROOT/claude/settings.json"
    shared_json_guard "$claude_settings_src"
    jq -e 'type == "object"' "$claude_settings_src" >/dev/null || die "shared Claude settings must be a JSON object"
  fi
  if shared_source "$SHARED_ROOT/AGENTS.md"; then
    agents_md_src="$SHARED_ROOT/AGENTS.md"
    case "$agents_md_src" in
      *[[:space:]]*) die "shared AGENTS.md path must not contain whitespace (Claude cannot import it): $agents_md_src" ;;
    esac
  fi
  if shared_source "$SHARED_ROOT/codex/config.toml"; then
    codex_toml_src="$SHARED_ROOT/codex/config.toml"
    shared_toml_guard "$codex_toml_src"
  fi
  if [ -d "$SHARED_ROOT/copilot/hooks" ]; then
    for hook_src in "$SHARED_ROOT/copilot/hooks"/*.json; do
      shared_source "$hook_src" || continue
      require_jq
      shared_json_guard "$hook_src"
      case "$(basename "$hook_src")" in
        *[!A-Za-z0-9._-]*) die "shared Copilot hook names may use letters, digits, '.', '_' and '-' only: $hook_src" ;;
      esac
      copilot_hooks="$copilot_hooks $hook_src"
    done
  fi

  drift=0
  for profile in $profiles; do
    profile_root="$ACCOUNT_ROOT/$profile"
    if [ "$check" -eq 0 ]; then
      secure_dirs
      provider_dirs "$profile"
    elif [ ! -d "$profile_root" ]; then
      printf '%s: not initialized\n' "$profile"
      drift=1
      continue
    fi
    [ ! -L "$profile_root/copilot/hooks" ] || die "Copilot hook directory must not be a symbolic link: $profile_root/copilot/hooks"
    stage=$(mktemp -d "${TMPDIR:-/tmp}/muximate-shared.XXXXXX")
    # Each line: rendered file, destination.
    plan="$stage/plan"
    : >"$plan"

    claude_settings="$profile_root/claude/settings.json"
    claude_owned="$profile_root/claude/.muximate-shared-settings.json"
    shared_target "$claude_settings"
    shared_target "$claude_owned"
    if [ -n "$claude_settings_src" ] || [ -s "$claude_owned" ]; then
      require_jq
      render_claude_settings "$claude_settings" "$claude_settings_src" "$claude_owned" \
        "$stage/claude-settings" "$stage/claude-owned" "$stage/claude-conflicts"
      if [ ! -e "$claude_settings" ] && [ "$(jq -c . "$stage/claude-settings")" = '{}' ]; then
        : >"$stage/claude-settings"
      fi
      if [ "$(jq -c . "$stage/claude-owned")" = '{}' ]; then : >"$stage/claude-owned"; fi
      printf '%s\t%s\n' "$stage/claude-settings" "$claude_settings" >>"$plan"
      printf '%s\t%s\n' "$stage/claude-owned" "$claude_owned" >>"$plan"
      while IFS= read -r conflict; do
        printf '%s: profile keeps its own Claude value for %s\n' "$profile" "$conflict"
      done <"$stage/claude-conflicts"
    fi

    # Claude imports the shared AGENTS.md, Copilot reads it through the
    # COPILOT_CUSTOM_INSTRUCTIONS_DIRS that `muximate env` exports, and Codex, which has no
    # import, gets a managed copy.
    claude_import=
    if [ -n "$agents_md_src" ]; then
      claude_import="$stage/claude-import"
      printf '@%s\n' "$agents_md_src" >"$claude_import"
    fi
    for block_spec in \
      "claude/CLAUDE.md|$claude_import|md" \
      "codex/AGENTS.md|$agents_md_src|md" \
      "codex/config.toml|$codex_toml_src|toml"; do
      rel=${block_spec%%|*}
      rest=${block_spec#*|}
      src=${rest%|*}
      kind=${rest##*|}
      dest="$profile_root/$rel"
      shared_target "$dest"
      [ -n "$src" ] || [ -f "$dest" ] || continue
      rendered="$stage/$(printf '%s' "$rel" | tr '/' '_')"
      if [ "$kind" = toml ]; then
        [ -z "$src" ] || [ ! -f "$dest" ] || toml_table_conflicts "$src" "$dest"
        render_block "$dest" "$src" "$SHARED_TOML_BEGIN" "$SHARED_TOML_END" "$rendered"
      else
        render_block "$dest" "$src" "$SHARED_MD_BEGIN" "$SHARED_MD_END" "$rendered"
      fi
      printf '%s\t%s\n' "$rendered" "$dest" >>"$plan"
    done

    # Copilot hooks: shared files are copied under a muximate-shared- prefix that the
    # profile must not use for its own hooks; stale prefixed files are removed.
    hook_dir="$profile_root/copilot/hooks"
    for hook_src in $copilot_hooks; do
      dest="$hook_dir/muximate-shared-$(basename "$hook_src")"
      shared_target "$dest"
      cp "$hook_src" "$stage/hook-$(basename "$hook_src")"
      printf '%s\t%s\n' "$stage/hook-$(basename "$hook_src")" "$dest" >>"$plan"
    done
    stale_hooks=
    if [ -d "$hook_dir" ]; then
      for existing in "$hook_dir"/muximate-shared-*.json; do
        [ -e "$existing" ] || continue
        name=${existing##*/muximate-shared-}
        case " $copilot_hooks " in *"/copilot/hooks/$name "*) ;; *) stale_hooks="$stale_hooks $existing" ;; esac
      done
    fi

    if [ "$check" -eq 1 ]; then
      while IFS='	' read -r rendered dest; do
        if [ -s "$rendered" ] || [ -e "$dest" ]; then
          if ! { [ -f "$dest" ] && cmp -s "$rendered" "$dest"; }; then
            printf '%s: out of date: %s\n' "$profile" "$dest"
            drift=1
          fi
        fi
      done <"$plan"
      for existing in $stale_hooks; do
        printf '%s: stale shared hook: %s\n' "$profile" "$existing"
        drift=1
      done
    else
      [ -z "$copilot_hooks" ] || {
        mkdir -p "$hook_dir"
        chmod 700 "$hook_dir"
      }
      while IFS='	' read -r rendered dest; do
        if [ ! -s "$rendered" ] && [ -f "$dest" ] && [ "${dest##*/}" = .muximate-shared-settings.json ]; then
          rm -f "$dest" "$rendered"
          continue
        fi
        install_rendered "$rendered" "$dest"
      done <"$plan"
      for existing in $stale_hooks; do
        rm -f "$existing"
        printf 'removed: %s\n' "$existing"
      done
      printf 'synced shared agent layer: %s\n' "$profile"
    fi
    rm -rf "$stage"
  done
  if [ "$check" -eq 1 ]; then
    if [ "$drift" -eq 0 ]; then printf 'shared agent layer: in sync\n'; fi
    return "$drift"
  fi
}
cmd_project_mise() {
  action=${1:-}
  target=$(canonical "${2:-"$PWD"}")
  line=$(entry_line "$target")
  mise=$(field "$line" 3)
  case "$action" in
    enable)
      [ ! -e "$target/mise.toml" ] && [ ! -L "$target/mise.toml" ] || die "$target/mise.toml already exists"
      cp "$mise" "$target/mise.toml"
      printf 'Copied machine-local mise config to %s/mise.toml\n' "$target"
      ;;
    disable)
      [ ! -e "$target/mise.toml" ] && {
        printf 'No project mise.toml exists at %s\n' "$target"
        return
      }
      [ ! -e "$target/mise.toml.disabled" ] && [ ! -L "$target/mise.toml.disabled" ] || die "refusing to overwrite mise.toml.disabled"
      mv "$target/mise.toml" "$target/mise.toml.disabled"
      printf 'Project mise config disabled at %s\n' "$target"
      ;;
    *) die "usage: muximate project-mise enable|disable [folder]" ;;
  esac
}
cmd_tool_set() {
  if [ $# -eq 1 ]; then
    target=$PWD
    tool=$1
  else
    target=${1:-"$PWD"}
    tool=${2:-}
  fi
  line=$(entry_line "$target")
  mise=$(field "$line" 3)
  case "$tool" in *@*) ;; *) die "tool must include an exact version" ;; esac
  validate_text "tool selector" "$tool"
  tool_name=${tool%@*}
  [ -n "$tool_name" ] || die "tool name is missing"
  version=${tool##*@}
  if ! printf '%s\n' "$version" | awk '!/^[0-9]+\.[0-9]+\.[0-9]+([+.-][A-Za-z0-9.-]+)?$/ {bad=1} END {exit bad}'; then
    die "tool versions must use exact semantic versions"
  fi
  MISE_GLOBAL_CONFIG_FILE="$mise" MISE_LOCKED=0 "$(mise_bin)" use --path "$mise" --pin "$tool"
  cmd_tool_lock "$target"
}
cmd_tool_lock() {
  target=${1:-"$PWD"}
  line=$(entry_line "$target")
  mise=$(field "$line" 3)
  staging=$(mktemp -d "${TMPDIR:-/tmp}/muximate-lock.XXXXXX")
  lock_dir=$(dirname "$mise")
  lock="$lock_dir/mise.lock"
  [ ! -L "$lock" ] || die "mise lockfile must not be a symbolic link: $lock"
  cp "$mise" "$staging/mise.toml"
  "$(mise_bin)" trust "$staging/mise.toml" >/dev/null
  (cd "$staging" && MISE_LOCKED=0 "$(mise_bin)" lock)
  [ -r "$staging/mise.lock" ] || die "mise did not create a lockfile"
  cp "$staging/mise.lock" "$lock"
  chmod 600 "$lock"
  rm -rf "$staging"
  printf 'Locked profile tools: %s\n' "$lock"
}
cmd_tool_install() {
  if [ $# -gt 0 ] && [ -d "$1" ]; then
    target=$1
    shift
  else target=$PWD; fi
  line=$(entry_line "$target")
  mise=$(field "$line" 3)
  MISE_GLOBAL_CONFIG_FILE="$mise" MISE_LOCKED=1 "$(mise_bin)" install "$@" --locked
}
cmd_tool_update() {
  scope=profile
  bump=
  while [ $# -gt 0 ]; do
    case "$1" in
      --profile) scope=profile ;;
      --project) scope=project ;;
      --bump) bump=--bump ;;
      --)
        shift
        break
        ;;
      *) break ;;
    esac
    shift
  done
  if [ $# -gt 0 ] && [ -d "$1" ]; then
    target=$1
    shift
  else target=$PWD; fi
  line=$(entry_line "$target")
  target=$(canonical "$target")
  case "$scope" in
    profile)
      # Profile tools: only the machine-local profile mise.toml is read, never a project file.
      mise=$(field "$line" 3)
      staging=$(mktemp -d "${TMPDIR:-/tmp}/muximate-update.XXXXXX")
      (cd "$staging" && MISE_GLOBAL_CONFIG_FILE="$mise" MISE_LOCKED=0 "$(mise_bin)" upgrade ${bump:+"$bump"} "$@")
      rm -rf "$staging"
      cmd_tool_lock "$target"
      ;;
    project)
      # Project tools: only the project's mise.toml and mise.lock are touched.
      [ -f "$target/mise.toml" ] && [ ! -L "$target/mise.toml" ] || die "no regular mise.toml in $target (see: muximate project-mise enable)"
      [ ! -L "$target/mise.lock" ] || die "mise lockfile must not be a symbolic link: $target/mise.lock"
      env -u MISE_GLOBAL_CONFIG_FILE "$(mise_bin)" trust "$target/mise.toml" >/dev/null
      (cd "$target" && env -u MISE_GLOBAL_CONFIG_FILE MISE_LOCKED=0 "$(mise_bin)" upgrade --local ${bump:+"$bump"} "$@")
      (cd "$target" && env -u MISE_GLOBAL_CONFIG_FILE MISE_LOCKED=0 "$(mise_bin)" lock)
      [ -r "$target/mise.lock" ] || die "mise did not create a lockfile"
      printf 'Locked project tools: %s/mise.lock\n' "$target"
      ;;
  esac
}
cmd_tool_list() {
  line=$(entry_line "${1:-"$PWD"}")
  mise=$(field "$line" 3)
  MISE_GLOBAL_CONFIG_FILE="$mise" "$(mise_bin)" ls --json 2>/dev/null || MISE_GLOBAL_CONFIG_FILE="$mise" "$(mise_bin)" ls
}
cmd_tool_verify() {
  line=$(entry_line "${1:-"$PWD"}")
  mise=$(field "$line" 3)
  lock="$(dirname "$mise")/mise.lock"
  [ -r "$lock" ] || die "lockfile missing: $lock"
  grep -q checksum "$lock" || die "lockfile has no checksum metadata"
  grep -Eq 'provenance|attestation' "$lock" || die "lockfile has no provenance/attestation metadata"
  printf 'verified checksum and provenance metadata: %s\n' "$lock"
}

command=${1:-}
shift || true
case "$command" in
  init) cmd_init "$@" ;; baseline) cmd_baseline "$@" ;;
  provider-init) cmd_provider_init "$@" ;; agent-policy-init) cmd_agent_policy_init "$@" ;;
  agent-shared-sync) cmd_agent_shared_sync "$@" ;;
  profile-configure) cmd_profile_configure "$@" ;; git-configure) cmd_git_configure "$@" ;; disable) cmd_disable "${1:-"$PWD"}" ;;
  project-mise) cmd_project_mise "$@" ;; tool-set) cmd_tool_set "$@" ;;
  tool-install) cmd_tool_install "$@" ;; tool-update) cmd_tool_update "$@" ;;
  tool-list) cmd_tool_list "${1:-"$PWD"}" ;; tool-lock) cmd_tool_lock "${1:-"$PWD"}" ;;
  tool-verify) cmd_tool_verify "${1:-"$PWD"}" ;;
  *) exec "$FRONT" --from-backend "$command" "$@" ;;
esac
