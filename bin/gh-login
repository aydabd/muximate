#!/bin/sh
set -eu

[ $# -eq 1 ] || {
  printf '%s\n' 'usage: gh-login personal|work' >&2
  exit 2
}
profile=$1
[ "$profile" = personal ] || [ "$profile" = work ] || {
  printf '%s\n' 'profile must be personal or work' >&2
  exit 2
}
[ "${GH_LOGIN_TEST_MODE:-0}" = 1 ] || { [ -t 0 ] && [ -t 1 ]; } || {
  printf '%s\n' 'gh-login requires a human interactive terminal' >&2
  exit 2
}
unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN
active=$(muximate profile "$PWD" 2>/dev/null || true)
[ "$active" = "$profile" ] || {
  printf 'gh-login: folder profile is %s, requested %s\n' "${active:-uninitialized}" "$profile" >&2
  exit 2
}
config=$(muximate gh-config "$PWD")
browser_profile=$(muximate browser-profile "$PWD")
expected_config=${XDG_CONFIG_HOME:-"$HOME/.config"}/gh-$profile
[ "$config" = "$expected_config" ] || {
  printf 'gh-login: %s profile must use %s (found %s)\n' "$profile" "$expected_config" "$config" >&2
  exit 2
}
case "$config:$browser_profile" in
  *gh-directory-profiles-staged* | *workspace-profiles*)
    printf '%s\n' 'gh-login: refusing stale legacy GitHub/browser configuration' >&2
    exit 2
    ;;
esac
if [ -r "$config/config.yml" ] && grep -Eq 'gh-directory-profiles-staged|workspace-profiles' "$config/config.yml"; then
  printf 'gh-login: stale browser path in %s/config.yml; remove it after taking a backup\n' "$config" >&2
  exit 2
fi
case "$(uname -s 2>/dev/null || printf unknown)" in
  Darwin) ;;
  *)
    printf '%s\n' 'gh-login: cmux browser login is supported only on macOS' >&2
    exit 2
    ;;
esac
cmux_bin=${CMUX_BIN:-/Applications/cmux.app/Contents/Resources/bin/cmux}
[ -x "$cmux_bin" ] || {
  printf 'gh-login: cmux browser command is missing or not executable: %s\n' "$cmux_bin" >&2
  exit 2
}
export GH_CONFIG_DIR="$config"
export CMUX_BROWSER_PROFILE="$browser_profile"
export GH_BROWSER="${MUXIMATE_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/muximate}/bin/muximate-cmux-browser"
[ -x "$GH_BROWSER" ] || {
  printf 'gh-login: cmux browser adapter is missing or not executable: %s\n' "$GH_BROWSER" >&2
  exit 2
}
exec "${GH_LOGIN_GH_BIN:-gh}" auth login --hostname github.com --git-protocol ssh --web --scopes project
