#!/bin/sh
# POSIX command for directory profile state and lifecycle management.
set -eu

CONFIG_HOME=${XDG_CONFIG_HOME:-"$HOME/.config"}
ROOT=${MUXIMATE_ROOT:-"$CONFIG_HOME/muximate"}
REGISTRY="$ROOT/registry.tsv"
BASELINES="$ROOT/baselines.tsv"
BACKEND="$ROOT/bin/muximate-operations"

die() {
  printf '%s\n' "muximate: $*" >&2
  exit 2
}

validate_text() {
  label=$1
  value=$2
  tab=$(printf '\t')
  cr=$(printf '\r')
  nl=$(printf '\nx')
  nl=${nl%x}
  case "$value" in
    *"$tab"* | *"$cr"* | *"$nl"*) die "$label contains a forbidden control character" ;;
  esac
}

case "$ROOT" in
  /*) ;;
  *) die "configuration root must be an absolute path: $ROOT" ;;
esac
[ ! -L "$ROOT" ] || die "configuration root must not be a symbolic link: $ROOT"

canonical() {
  target=${1:-"$PWD"}
  if [ -d "$target" ]; then
    (cd "$target" && pwd -P)
    return
  fi
  parent=$(dirname "$target")
  base=$(basename "$target")
  [ -d "$parent" ] || die "folder does not exist: $target"
  (cd "$parent" && printf '%s/%s\n' "$PWD" "$base")
}

lookup_file() {
  file=$1
  target=$2
  [ -r "$file" ] || return 1
  awk -F '	' -v target="$target" '
    $1 != "" && $1 !~ /^#/ &&
    (target == $1 || index(target, $1 "/") == 1) &&
    length($1) > best_len { best = $0; best_len = length($1) }
    END { if (best != "") print best }
  ' "$file"
}

entry_line() {
  target=$(canonical "${1:-"$PWD"}")
  line=$(lookup_file "$REGISTRY" "$target" 2>/dev/null || true)
  [ -n "$line" ] || line=$(lookup_file "$BASELINES" "$target" 2>/dev/null || true)
  [ -n "$line" ] || die "folder is not initialized or covered by a baseline: $target"
  printf '%s\n' "$line"
}

field() {
  printf '%s\n' "$1" | awk -F '	' -v n="$2" '{print $n}'
}

profile_config() {
  profile=$1
  [ -r "$ROOT/profiles.tsv" ] || return 1
  awk -F '	' -v p="$profile" '$1 == p {print $2 "\t" $3; exit}' "$ROOT/profiles.tsv"
}

shell_quote() {
  escaped=$(printf '%s' "$1" | sed "s/'/'\\''/g")
  printf "'%s'" "$escaped"
}

json_quote() {
  escaped=$(printf '%s' "$1" | sed 's/[\\&]/\\\\&/g; s/"/\\"/g')
  printf '"%s"' "$escaped"
}

HEX16='[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]'

# A jar name a row of PROFILE may own: <profile>-<16hex> or <profile>-baseline-<16hex>.
valid_row_jar() {
  printf '%s\n' "$2" | LC_ALL=C grep -Eq "^$1-(baseline-)?[0-9a-f]{16}\$"
}

# Any jar muximate may create or touch for PROFILE, including identity jars.
own_jar_ok() {
  printf '%s\n' "$2" | LC_ALL=C grep -Eq "^$1-(baseline-)?[0-9a-f]{16}(--[a-z0-9][a-z0-9-]{0,31})?\$"
}

valid_slug() {
  validate_text "identity" "$1"
  printf '%s\n' "$1" | LC_ALL=C grep -Eq '^[a-z0-9][a-z0-9-]{0,31}$'
}

# Print the validated browser jar of a registry/baseline row; refuse anything
# that does not belong to the row's own profile (fail closed).
row_jar() {
  row_profile=$(field "$1" 2)
  row_browser=$(field "$1" 4)
  validate_text "browser profile" "$row_browser"
  [ "$row_profile" = personal ] || [ "$row_profile" = work ] || die "folder has an invalid profile"
  valid_row_jar "$row_profile" "$row_browser" ||
    die "browser profile does not belong to the $row_profile profile: $row_browser"
  printf '%s\n' "$row_browser"
}

find_cmux() {
  cmux_bin=${CMUX_BIN:-}
  if [ -z "$cmux_bin" ]; then cmux_bin=$(command -v cmux 2>/dev/null || true); fi
  if [ -z "$cmux_bin" ] && [ "$(uname -s 2>/dev/null || printf unknown)" = Darwin ]; then
    cmux_bin=/Applications/cmux.app/Contents/Resources/bin/cmux
  fi
  [ -x "$cmux_bin" ]
}

resolve_cmux() {
  find_cmux || die "cmux command is missing or not executable: ${cmux_bin:-unavailable}"
}

jar_lock="$ROOT/.browser-profiles.lock"
lock_jars() {
  lock_tries=0
  until mkdir "$jar_lock" 2>/dev/null; do
    lock_tries=$((lock_tries + 1))
    [ "$lock_tries" -le 100 ] || die "timed out waiting for $jar_lock (remove it if no muximate command is running)"
    sleep 0.1
  done
  trap 'rmdir "$jar_lock" 2>/dev/null || true' EXIT
}
unlock_jars() {
  rmdir "$jar_lock" 2>/dev/null || true
  trap - EXIT
}

# Create a jar only when it is inside the caller's namespace and missing.
ensure_jar() {
  own_jar_ok "$1" "$2" || die "refusing a browser profile outside the $1 namespace: $2"
  lock_jars
  jar_listing=$("$cmux_bin" browser profiles list) || die "cmux could not list browser profiles"
  if ! printf '%s\n' "$jar_listing" | awk -F '	' -v n="$2" '$1 == n {f=1} END {exit f ? 0 : 1}'; then
    "$cmux_bin" browser profiles add "$2" >/dev/null || die "cmux could not create browser profile: $2"
  fi
  unlock_jars
}

# Classify cmux profiles for PROFILE. Prints: name, kind, folder path or -, cmux marker or -.
# Kinds: folder-default identity legacy-baseline orphan unmanaged not-yours.
classify_jars() {
  cj_profile=$1
  cj_listing=$(mktemp "${TMPDIR:-/tmp}/muximate-jars.XXXXXX")
  "$cmux_bin" browser profiles list >"$cj_listing" || {
    rm -f "$cj_listing"
    die "cmux could not list browser profiles"
  }
  cj_files=
  for cj_table in "$REGISTRY" "$BASELINES"; do
    [ -r "$cj_table" ] && cj_files="$cj_files $cj_table"
  done
  # shellcheck disable=SC2086
  LC_ALL=C awk -F '	' -v OFS='	' -v P="$cj_profile" -v listing="$cj_listing" -v hex="$HEX16" '
    FILENAME != listing {
      if ($2 == P && $4 ~ ("^" P "-(baseline-)?" hex "$")) known[$4] = $1
      next
    }
    {
      name = $1
      idx = index($3, " ")
      marker = idx ? substr($3, idx + 1) : "-"
      kind = "not-yours"; path = "-"
      if (name == P || index(name, P "-") == 1) {
        kind = "unmanaged"
        base = name; slug = ""
        d = index(name, "--")
        if (d > 0) { base = substr(name, 1, d - 1); slug = substr(name, d + 2) }
        if (base ~ ("^" P "-(baseline-)?" hex "$")) {
          if (d == 0) {
            if (base in known) { kind = "folder-default"; path = known[base] }
            else kind = (base ~ ("^" P "-baseline-")) ? "legacy-baseline" : "orphan"
          } else if (slug ~ /^[a-z0-9][a-z0-9-]*$/ && length(slug) <= 32) {
            if (base in known) { kind = "identity"; path = known[base] }
            else kind = "orphan"
          }
        }
      }
      print name, kind, path, marker
    }
  ' $cj_files "$cj_listing" /dev/null
  rm -f "$cj_listing"
}

cmd_env() {
  printf 'unset MUXIMATE MUXIMATE_PATH CMUX_BROWSER_PROFILE MISE_ENABLED MISE_STATUS MISE_GLOBAL_CONFIG_FILE AWS_PROFILE AWS_CONFIG_FILE BROWSER KUBECONFIG MUXIMATE_STATUS CLAUDE_CONFIG_DIR CODEX_HOME COPILOT_HOME ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN OPENAI_API_KEY COPILOT_GITHUB_TOKEN GH_CONFIG_DIR GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN\n'
  line=$(entry_line "${1:-"$PWD"}")
  path=$(field "$line" 1)
  profile=$(field "$line" 2)
  mise=$(field "$line" 3)
  browser=$(row_jar "$line")
  enabled=$(field "$line" 6)
  "$BACKEND" provider-init "$profile" >/dev/null
  validate_text "folder path" "$path"
  validate_text "profile" "$profile"
  validate_text "mise configuration path" "$mise"
  validate_text "browser profile" "$browser"
  [ "$enabled" = 1 ] || enabled=0
  printf 'export MUXIMATE=%s\n' "$(shell_quote "$profile")"
  printf 'export MUXIMATE_PATH=%s\n' "$(shell_quote "$path")"
  printf 'export CMUX_BROWSER_PROFILE=%s\n' "$(shell_quote "$browser")"
  account_root="$ROOT/accounts/$profile"
  printf 'export CLAUDE_CONFIG_DIR=%s\n' "$(shell_quote "$account_root/claude")"
  printf 'export CODEX_HOME=%s\n' "$(shell_quote "$account_root/codex")"
  printf 'export COPILOT_HOME=%s\n' "$(shell_quote "$account_root/copilot")"
  profile_entry=$(profile_config "$profile" || true)
  if [ -n "$profile_entry" ]; then
    gh_config=$(field "$profile_entry" 1)
    validate_text "GitHub config path" "$gh_config"
    printf 'export GH_CONFIG_DIR=%s\n' "$(shell_quote "$gh_config")"
  else
    printf 'unset GH_CONFIG_DIR\n'
  fi
  if [ "$enabled" = 1 ]; then
    printf 'export MISE_ENABLED=1\n'
    printf 'export MISE_STATUS=on\n'
    printf 'export MISE_GLOBAL_CONFIG_FILE=%s\n' "$(shell_quote "$mise")"
    status="profile:$profile mise:on cmux:$browser ai:isolated"
  else
    printf 'unset MISE_ENABLED MISE_STATUS MISE_GLOBAL_CONFIG_FILE\n'
    status="profile:$profile mise:off cmux:$browser ai:isolated"
  fi
  printf 'export MUXIMATE_STATUS=%s\n' "$(shell_quote "$status")"
  kubeconfig="$ROOT/kubeconfig.$profile"
  if [ -r "$kubeconfig" ]; then
    printf 'export KUBECONFIG=%s\n' "$(shell_quote "$kubeconfig")"
  else
    printf 'unset KUBECONFIG\n'
  fi
  aws_config="$ROOT/aws-config.$profile"
  if [ -r "$aws_config" ]; then
    printf 'export AWS_CONFIG_FILE=%s\n' "$(shell_quote "$aws_config")"
  else
    printf 'unset AWS_CONFIG_FILE\n'
  fi
  browser_opener="$ROOT/bin/muximate-cmux-browser"
  if [ -x "$browser_opener" ]; then
    printf 'export BROWSER=%s\n' "$(shell_quote "$browser_opener")"
  else
    printf 'unset BROWSER\n'
  fi
}

cmd_status() {
  line=$(entry_line "${1:-"$PWD"}")
  browser=$(row_jar "$line")
  printf 'path: %s\nprofile: %s\nbrowser: %s\nmise: %s\nmise_enabled: %s\n' \
    "$(field "$line" 1)" "$(field "$line" 2)" "$browser" \
    "$(field "$line" 3)" "$(field "$line" 6)"
}

cmd_mise_status() {
  line=$(entry_line "${1:-"$PWD"}")
  enabled=$(field "$line" 6)
  [ "$enabled" = 1 ] && printf 'enabled\n' || printf 'disabled\n'
}

cmd_doctor() {
  target=${1:-"$PWD"}
  line=$(entry_line "$target")
  profile=$(field "$line" 2)
  browser=$(row_jar "$line")
  enabled=$(field "$line" 6)
  printf 'shell_backend: POSIX sh\n'
  printf 'platform: %s\n' "$(uname -s 2>/dev/null || printf unknown)"
  printf 'architecture: %s\n' "$(uname -m 2>/dev/null || printf unknown)"
  printf 'config_root: %s\n' "$ROOT"
  printf 'mise_root: %s\n' "$ROOT/mise"
  printf 'folder: %s\nprofile: %s\nbrowser_profile: %s\n' "$(canonical "$target")" "$profile" "$browser"
  if [ "$enabled" = 1 ]; then printf 'mise: enabled\n'; else printf 'mise: disabled\n'; fi
  if command -v mise >/dev/null 2>&1; then printf 'mise_binary: %s\n' "$(command -v mise)"; else printf 'mise_binary: unavailable\n'; fi
  if find_cmux; then
    printf 'cmux: available\n'
    if jar_listing=$("$cmux_bin" browser profiles list 2>/dev/null); then
      if printf '%s\n' "$jar_listing" | awk -F '	' -v n="$browser" '$1 == n {f=1} END {exit f ? 0 : 1}'; then
        printf 'cmux_folder_profile: present\n'
      else
        printf 'cmux_folder_profile: missing\n'
      fi
      orphans=$(classify_jars "$profile" | awk -F '	' '$2 == "orphan" || $2 == "legacy-baseline" {n++} END {print n + 0}')
      printf 'orphan_profiles: %s\n' "$orphans"
      [ "$orphans" -eq 0 ] || printf 'hint: run: muximate browser-profiles prune\n'
    else
      printf 'cmux_folder_profile: unknown\n'
    fi
  else
    printf 'cmux: unavailable\n'
  fi
  if [ "$enabled" = 1 ]; then printf 'tool_policy: mise-managed only\n'; else printf 'tool_policy: existing system/Homebrew tools unchanged\n'; fi
}

cmd_agent_teams() {
  integration=$1
  shift
  [ "$integration" = claude-teams ] || [ "$integration" = codex-teams ] ||
    die "unsupported cmux agent integration: $integration"
  target=$(canonical "$PWD")
  line=$(entry_line "$target")
  path=$(field "$line" 1)
  profile=$(field "$line" 2)
  [ "$profile" = personal ] || [ "$profile" = work ] || die "folder has an invalid profile"
  eval "$(cmd_env "$target")"
  cmux_bin=${CMUX_BIN:-}
  if [ -z "$cmux_bin" ]; then
    cmux_bin=$(command -v cmux 2>/dev/null || true)
  fi
  if [ -z "$cmux_bin" ] && [ "$(uname -s 2>/dev/null || printf unknown)" = Darwin ]; then
    cmux_bin=/Applications/cmux.app/Contents/Resources/bin/cmux
  fi
  [ -x "$cmux_bin" ] || die "cmux command is missing or not executable: ${cmux_bin:-unavailable}"
  cd "$path"
  exec "$cmux_bin" "$integration" "$@"
}

cmd_cmux_browser_open() {
  usage_text="usage: muximate cmux-browser-open [--identity <slug>] URL"
  identity=
  have_identity=0
  url=
  have_url=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --identity)
        [ $# -ge 2 ] && [ "$have_identity" -eq 0 ] || die "$usage_text"
        identity=$2
        have_identity=1
        shift 2
        ;;
      *)
        [ "$have_url" -eq 0 ] || die "$usage_text"
        url=$1
        have_url=1
        shift
        ;;
    esac
  done
  [ "$have_url" -eq 1 ] || die "$usage_text"
  if [ "$have_identity" -eq 1 ]; then
    valid_slug "$identity" || die "identity must match [a-z0-9][a-z0-9-]{0,31}"
  fi
  validate_text "browser URL" "$url"
  [ "${#url}" -le 8192 ] || die "browser URL is too long"
  case "$url" in
    [Hh][Tt][Tt][Pp]://* | [Hh][Tt][Tt][Pp][Ss]://*) ;;
    *) die "browser URL must use HTTP or HTTPS" ;;
  esac
  case "$url" in *[[:space:]]*) die "browser URL contains whitespace" ;; esac
  url_rest=${url#*://}
  url_authority=${url_rest%%/*}
  url_authority=${url_authority%%\?*}
  url_authority=${url_authority%%\#*}
  [ -n "$url_authority" ] || die "browser URL must include a host"
  case "$url_authority" in *@*) die "browser URL must not include user information" ;; esac
  line=$(entry_line "$PWD")
  browser=$(row_jar "$line")
  resolve_cmux
  if [ "$have_identity" -eq 1 ]; then
    browser="$browser--$identity"
    ensure_jar "$(field "$line" 2)" "$browser"
  fi
  exec "$cmux_bin" browser open "$url" --profile "$browser"
}

cmd_browser_profiles() {
  action=${1:-}
  [ $# -eq 0 ] || shift
  line=$(entry_line "$PWD")
  bp_profile=$(field "$line" 2)
  bp_jar=$(row_jar "$line")
  case "$action" in
    list)
      bp_all=0
      case "${1:-}" in
        --all) bp_all=1 ;;
        '') ;;
        *) die "usage: muximate browser-profiles list [--all]" ;;
      esac
      [ $# -le 1 ] || die "usage: muximate browser-profiles list [--all]"
      resolve_cmux
      classify_jars "$bp_profile" | awk -F '	' -v all="$bp_all" 'all == 1 || $2 != "not-yours"'
      ;;
    clear)
      bp_identity=
      bp_default=0
      bp_force=0
      while [ $# -gt 0 ]; do
        case "$1" in
          --identity)
            [ $# -ge 2 ] && [ -z "$bp_identity" ] || die "usage: muximate browser-profiles clear --identity <slug>|--default [--force]"
            bp_identity=$2
            shift
            ;;
          --default) bp_default=1 ;;
          --force) bp_force=1 ;;
          *) die "usage: muximate browser-profiles clear --identity <slug>|--default [--force]" ;;
        esac
        shift
      done
      if [ -n "$bp_identity" ]; then
        [ "$bp_default" -eq 0 ] || die "choose either --identity or --default"
        valid_slug "$bp_identity" || die "identity must match [a-z0-9][a-z0-9-]{0,31}"
        bp_name="$bp_jar--$bp_identity"
      else
        [ "$bp_default" -eq 1 ] || die "usage: muximate browser-profiles clear --identity <slug>|--default [--force]"
        bp_name=$bp_jar
      fi
      own_jar_ok "$bp_profile" "$bp_name" || die "refusing a browser profile outside the $bp_profile namespace: $bp_name"
      resolve_cmux
      classify_jars "$bp_profile" | awk -F '	' -v n="$bp_name" '$1 == n {f=1} END {exit f ? 0 : 1}' ||
        die "browser profile does not exist: $bp_name"
      if [ "$bp_force" -ne 1 ]; then
        printf 'would clear: %s\nre-run with --force to clear it\n' "$bp_name"
        exit 1
      fi
      lock_jars
      "$cmux_bin" browser profiles clear "$bp_name" >/dev/null || die "cmux could not clear browser profile: $bp_name"
      unlock_jars
      printf 'cleared: %s\n' "$bp_name"
      ;;
    prune)
      bp_force=0
      case "${1:-}" in
        --force) bp_force=1 ;;
        '') ;;
        *) die "usage: muximate browser-profiles prune [--force]" ;;
      esac
      [ $# -le 1 ] || die "usage: muximate browser-profiles prune [--force]"
      resolve_cmux
      lock_jars
      bp_table=$(classify_jars "$bp_profile")
      bp_deleted=0
      bp_candidates=$(printf '%s\n' "$bp_table" | awk -F '	' '
        ($2 == "orphan" || $2 == "legacy-baseline") && $4 !~ /last used|default/ {print $1 "\t" $2}')
      if [ -n "$bp_candidates" ]; then
        bp_names=$(printf '%s\n' "$bp_candidates" | awk -F '	' '{print $1}')
        for bp_name in $bp_names; do
          own_jar_ok "$bp_profile" "$bp_name" || die "refusing a browser profile outside the $bp_profile namespace: $bp_name"
          bp_kind=$(printf '%s\n' "$bp_candidates" | awk -F '	' -v n="$bp_name" '$1 == n {print $2}')
          if [ "$bp_force" -eq 1 ]; then
            "$cmux_bin" browser profiles delete "$bp_name" >/dev/null || die "cmux could not delete browser profile: $bp_name"
            printf 'delete: %s (%s)\n' "$bp_name" "$bp_kind"
            bp_deleted=$((bp_deleted + 1))
          else
            printf 'would delete: %s (%s)\n' "$bp_name" "$bp_kind"
          fi
        done
      fi
      unlock_jars
      printf 'deleted: %s\n' "$bp_deleted"
      printf '%s\n' "$bp_table" | awk -F '	' -v deleted="$bp_force" '
        $2 == "not-yours" { next }
        ($2 == "orphan" || $2 == "legacy-baseline") && $4 !~ /last used|default/ { next }
        { kept++; if ($4 ~ /last used|default/) reason["in use by cmux (last used/default)"]++; else reason[$2]++ }
        END {
          printf "kept: %d\n", kept
          for (r in reason) printf "  %s: %d\n", r, reason[r]
        }'
      [ "$bp_force" -eq 1 ] || printf 'dry run: nothing deleted; re-run with --force to delete the listed profiles\n'
      ;;
    *) die "usage: muximate browser-profiles list [--all] | clear --identity <slug>|--default [--force] | prune [--force]" ;;
  esac
}

cmd_cmux_config() {
  target=$(canonical "${1:-"$PWD"}")
  line=$(entry_line "$target")
  path=$(field "$line" 1)
  profile=$(field "$line" 2)
  browser=$(row_jar "$line")
  profile_entry=$(profile_config "$profile" || true)
  [ -n "$profile_entry" ] || die "profile $profile has no GitHub config; run profile-configure"
  gh_config=$(field "$profile_entry" 1)
  validate_text "GitHub config path" "$gh_config"
  account_root="$ROOT/accounts/$profile"
  cat <<EOF
{
  "actions": {
    "muximate.browser": {
      "type": "command",
      "title": "Profile Browser",
      "command": "muximate cmux-browser-open https://github.com",
      "target": "newTabInCurrentPane"
    }
  },
  "commands": [
    {
      "name": $(json_quote "Muximate $profile"),
      "description": "Profile-guarded Claude and Codex Teams workspace",
      "workspace": {
        "name": $(json_quote "Muximate $profile"),
        "cwd": $(json_quote "$path"),
        "env": {
          "MUXIMATE": $(json_quote "$profile"),
          "GH_CONFIG_DIR": $(json_quote "$gh_config"),
          "CLAUDE_CONFIG_DIR": $(json_quote "$account_root/claude"),
          "CODEX_HOME": $(json_quote "$account_root/codex"),
          "COPILOT_HOME": $(json_quote "$account_root/copilot"),
          "CMUX_BROWSER_PROFILE": $(json_quote "$browser")
        },
        "layout": {
          "direction": "horizontal",
          "split": 0.5,
          "children": [
            { "pane": { "surfaces": [
              { "type": "terminal", "name": "Claude Teams", "command": "muximate claude-teams", "focus": true }
            ] } },
            { "pane": { "surfaces": [
              { "type": "terminal", "name": "Codex Teams", "command": "muximate codex-teams" }
            ] } }
          ]
        }
      }
    }
  ]
}
EOF
}

cmd_setup() {
  cat <<'EOF'
muximate setup (inspect-only; no files or credentials are changed)
1. Install or select the profile command: muximate is POSIX sh.
EOF
  if command -v mise >/dev/null 2>&1; then
    printf '   mise: available (%s)\n' "$(command -v mise)"
  else
    cat <<'EOF'
   mise: missing (optional; install it only if you choose mise-managed tools)
EOF
  fi
  adapter=${MUXIMATE_ZSH_ADAPTER:-"$ROOT/zsh/muximate.zsh"}
  if [ -r "$adapter" ]; then
    printf '2. generic zsh adapter: available (%s)\n' "$adapter"
  else
    cat <<'EOF'
2. generic zsh adapter: unavailable (optional; source the installed adapter when available)
EOF
  fi
  cat <<'EOF'
3. Initialize a folder: muximate init personal|work /absolute/folder
4. Configure only the identity paths you own: muximate profile-configure ...
5. Authenticate GitHub manually: gh-login personal|work in the matching folder.
6. Opt into mise explicitly: muximate mise enable /absolute/folder
7. Inspect everything: muximate doctor /absolute/folder
Credentials, SSH/GPG keys, Git config, Oh My Zsh, CMUX, and Docker remain user-owned opt-ins.
EOF
}

cmd_help() {
  cat <<'EOF'
muximate — explicit, fail-closed folder profiles

Safe first commands:
  muximate setup
  muximate init personal|work /absolute/folder
  muximate status [folder]
  muximate doctor [folder]
  muximate env [folder]

Optional integrations:
  muximate mise enable|disable [folder]
  muximate profile-configure personal|work gh-config-dir ssh-key
  muximate git-configure personal|work name email signing-key
  muximate agent-policy-init personal|work
  muximate ssh-config personal|work
  muximate claude-teams [claude arguments...]
  muximate codex-teams [codex arguments...]
  muximate cmux-config [folder]
  muximate cmux-browser-open [--identity <slug>] URL
  muximate browser-profiles list [--all]
  muximate browser-profiles clear --identity <slug>|--default [--force]
  muximate browser-profiles prune [--force]
  gh-login personal|work                 # human interactive only

Mise tools (only after mise enable):
  muximate tool-set [folder] tool@x.y.z
  muximate tool-lock|tool-install|tool-verify [folder]
  muximate tool-update [--profile|--project] [--bump] [folder] [tool...]

Agent policy initialization creates only missing profile-scoped guidance and never overwrites it.
No command copies private keys, credentials, Git config, or Oh My Zsh files.
EOF
}

cmd_ssh_config() {
  profile=${1:-}
  [ "$profile" = personal ] || [ "$profile" = work ] || die "usage: muximate ssh-config personal|work"
  [ -r "$ROOT/profiles.tsv" ] || die "profile configuration is missing"
  key=$(awk -F '	' -v p="$profile" '$1 == p {print $3; exit}' "$ROOT/profiles.tsv")
  [ -n "$key" ] || die "profile $profile has no SSH key; run muximate profile-configure"
  case "$key" in /*) ;; *) die "SSH key path must be absolute" ;; esac
  validate_text "SSH key path" "$key"
  escaped_key=$(printf '%s' "$key" | sed 's/[\\"]/[\&]/g')
  printf '# Include this output from ~/.ssh/config after reviewing it.\n'
  printf 'Match host github.com exec "test \\\"$MUXIMATE\\\" = %s"\n' "$profile"
  printf '    HostName github.com\n    User git\n    IdentityFile none\n    IdentityFile "%s"\n    IdentitiesOnly yes\n    IdentityAgent none\n\n' "$escaped_key"
}

cmd_field() {
  line=$(entry_line "${2:-"$PWD"}")
  field "$line" "$1"
}

cmd_mise() {
  action=${1:-}
  target=$(canonical "${2:-"$PWD"}")
  [ "$action" = enable ] || [ "$action" = disable ] ||
    die "usage: muximate mise enable|disable [folder]"
  line=$(entry_line "$target")
  path=$(field "$line" 1)
  state=0
  [ "$action" = enable ] && state=1
  if lookup_file "$REGISTRY" "$target" 2>/dev/null | awk -F '	' -v p="$target" '$1 == p {found=1} END {exit found ? 0 : 1}'; then
    table="$REGISTRY"
  else
    table="$BASELINES"
  fi
  [ -r "$table" ] || die "profile registry is missing: $table"
  tmp=$(mktemp "$ROOT/mise-state.XXXXXX")
  awk -F '	' -v OFS='	' -v p="$path" -v s="$state" '$1 == p {$6=s} {print}' "$table" >"$tmp"
  mv "$tmp" "$table"
  chmod 600 "$table"
  printf 'mise %s: %s\n' "$action" "$path"
}

usage() {
  cat <<'EOF'
Usage: muximate status|env|profile|browser-profile|browser-profiles|mise-config|mise-status|doctor [folder]
       muximate mise enable|disable [folder]
       muximate <command> ...
EOF
  exit 2
}

from_backend=0
if [ "${1:-}" = --from-backend ]; then
  from_backend=1
  shift
fi
command=${1:-}
case "$command" in
  env)
    shift
    cmd_env "${1:-"$PWD"}"
    ;;
  status)
    shift
    cmd_status "${1:-"$PWD"}"
    ;;
  profile) cmd_field 2 "${2:-"$PWD"}" ;;
  browser-profile) row_jar "$(entry_line "${2:-"$PWD"}")" ;;
  browser-profiles)
    shift
    cmd_browser_profiles "$@"
    ;;
  mise-config) cmd_field 3 "${2:-"$PWD"}" ;;
  gh-config)
    line=$(entry_line "${2:-"$PWD"}")
    profile=$(field "$line" 2)
    config=$(profile_config "$profile" || true)
    [ -n "$config" ] || die "profile $profile has no GitHub config; run profile-configure"
    gh_config=$(field "$config" 1)
    validate_text "GitHub config path" "$gh_config"
    field "$config" 1
    ;;
  profile-gh-config) profile_config "${2:-}" | awk -F '	' '{print $1}' ;;
  mise-status)
    shift
    cmd_mise_status "${1:-"$PWD"}"
    ;;
  doctor)
    shift
    cmd_doctor "${1:-"$PWD"}"
    ;;
  claude-teams | codex-teams)
    shift
    cmd_agent_teams "$command" "$@"
    ;;
  cmux-config)
    shift
    cmd_cmux_config "${1:-"$PWD"}"
    ;;
  cmux-browser-open)
    shift
    cmd_cmux_browser_open "$@"
    ;;
  setup) cmd_setup ;;
  help | -h | --help | '') cmd_help ;;
  ssh-config)
    shift
    cmd_ssh_config "${1:-}"
    ;;
  mise)
    shift
    cmd_mise "$@"
    ;;
  *)
    # The backend owns its commands. A command it does not recognise is handed back
    # with a --from-backend marker; reject it here instead of delegating again.
    [ "$from_backend" -eq 0 ] || die "unknown command: $command"
    [ -x "$BACKEND" ] || die "command is unavailable: $command"
    exec "$BACKEND" "$@"
    ;;
esac
